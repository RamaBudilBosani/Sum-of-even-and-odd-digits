n = int(input("Enter the number: "))
even = 0
odd = 0

while n > 0:
    
    if (n% 10) % 2 == 0:
        even += n % 10
        n = n//10
    elif (n % 10) % 2 != 0:
        odd += n % 10
        n = n//10
        
print("The sum of even digits is: ", even)
print("The sum of odd digits is: ", odd)
